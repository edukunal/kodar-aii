# Server
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Database — SQLite for local dev; use PostgreSQL in production
DATABASE_URL=file:./prisma/dev.db
# DATABASE_URL=postgresql://kodari:kodari@localhost:5432/kodari?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_DAYS=30

# CORS — frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:3000

# OAuth (optional — dev mock auth works without these)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/auth/github/callback

# Discord bot service-to-service
DISCORD_BOT_API_SECRET=change-me-discord-bot-secret

# Compile service (legacy integration)
COMPILE_BACKEND_SECRET=
